  {"name": "clean_transcript: you", "fn": "clean_transcript", "args": ["You"]},
  {"name": "clean_transcript: you know is speech", "fn": "clean_transcript", "args": ["You know what"]},
  {"name": "clean_transcript: (silence)", "fn": "clean_transcript", "args": ["(silence)"]},
  {"name": "clean_transcript: a dot", "fn": "clean_transcript", "args": [" . "]},
  {"name": "clean_transcript: two sentences", "fn": "clean_transcript", "args": ["Thank you. Bye."]},
  {"name": "clean_transcript: empty", "fn": "clean_transcript", "args": [""]},
  {"name": "clean_transcript: non-breaking space kept", "fn": "clean_transcript", "args": ["a\u00a0 b"]},

  {"name": "is_hallucination: Thank you", "fn": "is_hallucination", "args": ["Thank you"]},
