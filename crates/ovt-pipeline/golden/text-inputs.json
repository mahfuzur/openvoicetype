  {"name": "is_hallucination: music", "fn": "is_hallucination", "args": ["[Music]"]},
  {"name": "is_hallucination: any line", "fn": "is_hallucination", "args": ["hello\nyou"]},
  {"name": "is_hallucination: not this", "fn": "is_hallucination", "args": ["thank you!!"]},
  {"name": "is_hallucination: empty", "fn": "is_hallucination", "args": [""]},

  {"name": "system_prompt: default", "fn": "system_prompt"},
  {"name": "system_prompt: chat", "fn": "system_prompt", "vars": {"MODE": "chat"}},
  {"name": "system_prompt: email", "fn": "system_prompt", "vars": {"MODE": "email"}},
  {"name": "system_prompt: code", "fn": "system_prompt", "vars": {"MODE": "code"}},
  {"name": "system_prompt: notes", "fn": "system_prompt", "vars": {"MODE": "notes"}},
  {"name": "system_prompt: raw has no mode file", "fn": "system_prompt", "vars": {"MODE": "raw"}},
  {"name": "system_prompt: command", "fn": "system_prompt", "vars": {"JOB": "command"}},
  {"name": "system_prompt: command, email", "fn": "system_prompt", "vars": {"JOB": "command", "MODE": "email"}},
