  {"name": "clean_transcript: CRLF lines joined", "fn": "clean_transcript", "args": [" Hello\r\nworld \r\n"]},
  {"name": "clean_transcript: whitespace squeezed", "fn": "clean_transcript", "args": ["a\t\tb\n\n c  d\u000b\fe"]},
