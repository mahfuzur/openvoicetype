[
  {"name": "dictionary: terms, replacements, comments, CRLF", "fn": "load_dictionary",
   "dictionary": "# comment\r\nKubernetes\r\n\r\ncloud code => Claude Code\r\n  git hub=>GitHub  \r\n"},
  {"name": "dictionary: empty sides skipped, first => splits", "fn": "load_dictionary",
   "dictionary": "=> nothing\nnothing =>\n =>  \na => b => c\nplain term"},
  {"name": "dictionary: indented comment, tabs, last line without newline", "fn": "load_dictionary",
   "dictionary": "\t # indented comment\n\tTabbed\tTerm\t\nlast"},
  {"name": "dictionary: unicode", "fn": "load_dictionary", "dictionary": "Zürich\nmüller => Müller\nnaïve"},
  {"name": "dictionary: empty file", "fn": "load_dictionary", "dictionary": ""},
  {"name": "dictionary: no file", "fn": "load_dictionary"},

  {"name": "trim: spaces", "fn": "trim", "args": ["  a b  "]},
  {"name": "trim: tabs and newlines", "fn": "trim", "args": ["\t\n x y \r\n"]},
  {"name": "trim: empty", "fn": "trim", "args": [""]},
  {"name": "trim: only spaces", "fn": "trim", "args": [" \t \u000b\f "]},
  {"name": "trim: non-breaking space is kept", "fn": "trim", "args": ["\u00a0x\u00a0 "]},

  {"name": "word_count: empty", "fn": "word_count", "args": [""]},
  {"name": "word_count: one", "fn": "word_count", "args": ["one"]},
  {"name": "word_count: mixed whitespace", "fn": "word_count", "args": ["  one  two\tthree\nfour \r\n"]},
  {"name": "word_count: vertical tab and form feed", "fn": "word_count", "args": ["x\u000by\fz"]},

  {"name": "vocabulary: VOCAB and VTT_VOCAB", "fn": "vocabulary", "vars": {"VOCAB": "Kubernetes, AWS", "VTT_VOCAB": "OpenVoiceType"}},
  {"name": "vocabulary: duplicates across sources", "fn": "vocabulary", "vars": {"VOCAB": "AWS,GitHub", "VTT_VOCAB": "GitHub, AWS"},
   "dictionary": "AWS\nDocker\ngit hub => GitHub\ndocker => Docker"},
  {"name": "vocabulary: nothing", "fn": "vocabulary"},
  {"name": "vocabulary: empty fields and spaces", "fn": "vocabulary", "vars": {"VOCAB": ",, a ,,b,", "VTT_VOCAB": " , c"}},
  {"name": "vocabulary: a term with a comma hides a later one", "fn": "vocabulary", "dictionary": "a,b\nb\nc\nSmith, John"},
  {"name": "vocabulary: only the first line of VOCAB", "fn": "vocabulary", "vars": {"VOCAB": "x,y\nz", "VTT_VOCAB": "w"}},
  {"name": "vocabulary: VTT_VOCAB only", "fn": "vocabulary", "vars": {"VTT_VOCAB": "Claude Code,Haiku"}},
