  {"name": "vocabulary: case-sensitive de-dup", "fn": "vocabulary", "vars": {"VOCAB": "aws,AWS,Aws"}},

  {"name": "whisper_prompt: style and vocabulary", "fn": "whisper_prompt", "vars": {"VOCAB": "Kubernetes"}, "dictionary": "OpenVoiceType"},
  {"name": "whisper_prompt: style only", "fn": "whisper_prompt"},
  {"name": "whisper_prompt: off, with vocabulary", "fn": "whisper_prompt", "vars": {"WHISPER_PROMPT": "off", "VOCAB": "Kubernetes, Helm"}},
  {"name": "whisper_prompt: off, nothing", "fn": "whisper_prompt", "vars": {"WHISPER_PROMPT": "off"}},
